{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SBDevConnection": "Server=localhost;Database=InvoiceDb;Port=5432;User Id =postgres;Password=$Oscared94;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "CustomSettings": {
    "ApplicationName": "InvoiceGenerator",
    "Version": "1.0.0",
    "FeatureToggle": {
      "EnableNewFeatureX": true,
      "EnableBetaFeatures": false
    }
  },
  "OtherCustomSettings": {
    "Setting1": "Value1",
    "Setting2": "Value2",
    "Setting3": "3"
  }
}