{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SBDevConnection": "Server=invoicegenerator.database;Database=InvoiceDb;Port=5432;User Id=postgres;Password=postgres;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Keycloak": {
    "AuthorizationUrl": "http://localhost:8080/realms/invoice-generator-realm/protocol/openid-connect/auth"
  },
  "Authentication": {
    "Audience": "account",
    "Issuer": "http://localhost:8080/realms/invoice-generator-realm",
    "MetadataUrl": "http://localhost:8080/realms/invoice-generator-realm/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  }
}