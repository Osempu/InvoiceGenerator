{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SBDevConnection": "Server=localhost;Database=InvoiceDb;Port=54971;User Id=postgres;Password=postgres;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://invoicegenerator.seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "invoice-generator-realm",
    "ClientId": "invoicegenerator-api",
    "ClientSecret": "",
    "AuthorizationUrl": "http://localhost:8080/realms/invoice-generator-realm/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:8080/realms/invoice-generator-realm/protocol/openid-connect/token",
    "UserInfoUrl": "http://localhost:8080/realms/invoice-generator-realm/protocol/openid-connect/userinfo",
    "LogoutUrl": "http://localhost:8080/realms/invoice-generator-realm/protocol/openid-connect/logout",
    "AdminApiUrl": "http://localhost:8080/admin/realms/invoice-generator-realm"
  },
  "Authentication": {
    "Audience": "invoicegenerator-api",
    "ValidAudiences": [
      "invoicegenerator-api",
      "account"
    ],
    "Issuer": "http://localhost:8080/realms/invoice-generator-realm",
    "MetadataUrl": "http://localhost:8080/realms/invoice-generator-realm/.well-known/openid-configuration",
    "RequireHttpsMetadata": false,
    "ValidateAudience": false
  }
}